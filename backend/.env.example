# ---------------------------------------------------------------------------
# MediGram API — environment template
# Copy to backend/.env (local) or set in the Railway dashboard (production).
# NEVER commit backend/.env — real values live in ../supabase/server.env.
# ---------------------------------------------------------------------------

# HTTP
PORT=4000
NODE_ENV=development

# Supabase (service-role key MUST stay server-side only)
SUPABASE_URL=https://gaeuarvzqmgdmfkqjhg.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key          # used only for password grant
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# CORS: comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:63927

# Direct Postgres connection — lets `npm run gates` apply the schema and run
# Gate V1 without opening the SQL Editor.
# Find it: Supabase dashboard -> Project Settings -> Database -> Connection string
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.gaeuarvzqmgdmfkqjhg.supabase.co:5432/postgres

