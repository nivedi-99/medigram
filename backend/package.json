{
  "name": "medigram-api",
  "version": "1.0.0",
  "description": "MediGram B2B pharmaceutical export platform — Express API (Railway)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "smoke": "powershell -ExecutionPolicy Bypass -File scripts/smoke-test.ps1",
    "gates": "powershell -ExecutionPolicy Bypass -File scripts/run-gates.ps1",
    "db:schema": "node scripts/run-sql.mjs ../supabase/schema.sql",
    "db:verify": "node scripts/run-sql.mjs ../supabase/verify.sql"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  }
}
